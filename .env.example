# From @BotFather
BOT_TOKEN=8577206806:AAEkIBo1_4nIwzEk7-9fDyAZhU6c3061S1I

# Spotify developer app (https://developer.spotify.com/dashboard) - client credentials only
SPOTIFY_CLIENT_ID=d9931f95325f47fc98d4019dd35ae2f5
SPOTIFY_CLIENT_SECRET=072a7db2345e43b4928b1af7005c50c5

# --- YouTube / Instagram authentication ---------------------------------------------------------
# Netscape-format cookies.txt with a logged-in YouTube session (see README: "YouTube on a server").
# Create it on your own computer with ./scripts/export-cookies.sh and upload it to the server.
YTDLP_COOKIES=./cookies.txt
# Local development only (same machine as the browser). Never works on a server.
YTDLP_COOKIES_FROM_BROWSER=

# JavaScript runtime yt-dlp uses to solve YouTube challenges. Node is already installed for this app.
YTDLP_JS_RUNTIME=node
# YTDLP_REMOTE_COMPONENTS=ejs:github

# bgutil PO-token provider. docker-compose.yml sets this for you; for a manual run, start the provider
# (docker run -p 127.0.0.1:4416:4416 brainicism/bgutil-ytdlp-pot-provider) and set:
YTDLP_POT_BASE_URL=http://127.0.0.1:4416

# Optional proxy, most useful: a residential proxy when your server's IP is blocked by YouTube/Instagram.
# YTDLP_PROXY=http://user:pass@host:port
YTDLP_PROXY=

# --- Limits ----------------------------------------------------------------------------------------
# Telegram upload limit in MB. 50 on the public Bot API, up to 2000 with a local Bot API server
TG_MAX_MB=50
# Optional local Bot API server, e.g. http://telegram-bot-api:8081
TG_API_ROOT=
# Highest video quality offered in the YouTube menu
MAX_VIDEO_HEIGHT=1080
# Parallel downloads
MAX_CONCURRENT=2
